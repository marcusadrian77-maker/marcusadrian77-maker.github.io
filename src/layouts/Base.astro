---
import '../styles/global.css';
import { SITE, NAV_SERVICII, SCHEMA_LOCALBUSINESS } from '../data/site';
import { IMG } from '../data/images';
export interface Props { title: string; description: string; schemaExtra?: object | null; image?: string; }
const { title, description, schemaExtra = null, image = IMG.ogDefault } = Astro.props;
const canonical = new URL(Astro.url.pathname, SITE.domeniu).href;
const ogImage = new URL(image, SITE.domeniu).href;
---
<!doctype html>
<html lang="ro">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="ro_RO" />
<meta property="og:site_name" content={SITE.nume} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={title} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="theme-color" content="#14365d" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<script type="application/ld+json" set:html={JSON.stringify(SCHEMA_LOCALBUSINESS)} />
{schemaExtra && <script type="application/ld+json" set:html={JSON.stringify(schemaExtra)} />}
<!-- Google Analytics 4 -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-6GR5K9X0LN"></script>
<script is:inline>
window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', 'G-6GR5K9X0LN');
document.addEventListener('click', function (e) {
  var a = e.target.closest ? e.target.closest('a[href^="tel:"],a[href*="wa.me"],a[href*="api.whatsapp.com"]') : null;
  if (!a) return;
  var href = a.getAttribute('href') || '';
  var tip = href.indexOf('tel:') === 0 ? 'apel_telefon' : 'click_whatsapp';
  gtag('event', tip, { link_url: href, page_path: location.pathname });
});
</script>
</head>
<body>
<header class="site-header">
  <div class="wrap hd">
    <a class="logo" href="/" aria-label="Marcus Electronics — Acasă">
      <img src={IMG.logo} alt="Marcus Electronics" width="168" height="42" />
    </a>
    <input type="checkbox" id="nav-open" class="nav-toggle" aria-hidden="true" />
    <label for="nav-open" class="burger" aria-label="Deschide meniul"><span></span><span></span><span></span></label>
    <nav class="main" aria-label="Meniu principal">
      <ul>
        <li><a href="/">Acasă</a></li>
        <li><a href="/despre-noi/">Despre Noi</a></li>
        <li class="has-sub desk-only">
          <a href="/servicii/">Servicii</a>
          <div class="sub">
            {NAV_SERVICII.map(s => <a href={s.href}>{s.label}</a>)}
          </div>
        </li>
        <li class="mob-only">
          <details class="m-sub">
            <summary>Servicii</summary>
            <a href="/servicii/">Toate Serviciile</a>
            {NAV_SERVICII.map(s => <a href={s.href}>{s.label}</a>)}
          </details>
        </li>
        <li><a href="/preturi/">Prețuri</a></li>
        <li><a href="/intrebari-frecvente-faq-2/">FAQ</a></li>
        <li><a href="/contact/">Contact</a></li>
        <li><a class="tel" href={SITE.telefonHref}>📞 {SITE.telefon}</a></li>
      </ul>
    </nav>
  </div>
</header>
<main>
<slot />
</main>
<footer>
  <div class="wrap">
    <div class="cols">
      <div>
        <h4>Marcus Electronics</h4>
        <p style="margin:0;font-size:14px;">Service de reparații electronice în Militari, Sector 6, București. Reparații TV la domiciliu în {SITE.zonaDomiciliu}; laptopuri, MacBook, console, boxe, monitoare și cuptoare în atelier. Diagnostic gratuit, garanție 6–12 luni.</p>
      </div>
      <div>
        <h4>Contact</h4>
        <ul>
          <li>📍 {SITE.adresa}</li>
          <li>📞 <a href={SITE.telefonHref}>{SITE.telefon}</a></li>
          <li>💬 <a href={SITE.whatsapp} rel="noopener">WhatsApp</a></li>
          <li>✉️ <a href={'mailto:' + SITE.email}>{SITE.email}</a></li>
          <li>🕐 {SITE.program}</li>
        </ul>
      </div>
      <div>
        <h4>Servicii populare</h4>
        <ul>
          <li><a href="/reparatii-televizoare/">Reparații Televizoare</a></li>
          <li><a href="/reparatii-tv-sectoare/">Reparații TV la Domiciliu</a></li>
          <li><a href="/reparatii-laptopuri-bucuresti/">Reparații Laptopuri</a></li>
          <li><a href="/reparatii-macbook/">Reparații MacBook</a></li>
          <li><a href="/reparatii-mentenanta-console-ps4-ps5-xbox-manete/">Reparații Console</a></li>
        </ul>
      </div>
      <div>
        <h4>Ghiduri utile</h4>
        <ul>
          <li><a href="/televizor-samsung-nu-porneste/">TV Samsung nu pornește</a></li>
          <li><a href="/ps5-se-opreste-singur/">PS5 se oprește singur</a></li>
          <li><a href="/macbook-ecran-negru/">MacBook cu ecran negru</a></li>
          <li><a href="/curatare-laptop-praf/">Curățare laptop de praf</a></li>
        </ul>
      </div>
      <div>
        <h4>Informații</h4>
        <ul>
          <li><a href="/despre-noi/">Despre Noi</a></li>
          <li><a href="/preturi/">Prețuri</a></li>
          <li><a href="/intrebari-frecvente-faq-2/">Întrebări Frecvente</a></li>
          <li><a href="/termeni-si-conditii/">Termeni și Condiții</a></li>
          <li><a href="/politica-de-confidentialitate/">Politică de Confidențialitate</a></li>
          <li><a href="/gdpr/">GDPR</a></li>
        </ul>
      </div>
    </div>
    <div class="copy">
      <span>© {new Date().getFullYear()} {SITE.firma}. Toate drepturile rezervate.</span>
      <span><a href="https://anpc.ro" rel="noopener">ANPC</a> · <a href="https://ec.europa.eu/consumers/odr/" rel="noopener">SOL</a></span>
    </div>
  </div>
</footer>
<div class="floatcta">
  <a class="fc fc-call" href={SITE.telefonHref} aria-label="Sună acum"><span aria-hidden="true">📞</span><span class="lbl">Sună</span></a>
  <a class="fc fc-wa" href={SITE.whatsapp} rel="noopener" aria-label="Scrie pe WhatsApp"><span aria-hidden="true">💬</span><span class="lbl">WhatsApp</span></a>
</div>
</body>
</html>
