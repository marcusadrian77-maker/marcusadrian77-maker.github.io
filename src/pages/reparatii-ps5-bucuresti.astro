---
import Base from '../layouts/Base.astro';
import Cifre from '../components/Cifre.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import { IMG } from '../data/images';
import { SITE } from '../data/site';
import { breadcrumb, graf, serviciu } from '../data/schema';
const title = 'Reparații PS5 București | Service PS5, Slim și Pro';
const desc = 'Service PS5 în București: port HDMI, lichid metalic, cititor de disc, SSD, supraîncălzire, drift la DualSense. Diagnosticare gratuită, curățare inclusă.';

const preturi = [
  ['Curățare completă + pastă termică (inclusă gratuit în orice reparație)', '200 lei'],
  ['Reparare port HDMI (microsoldare)', '350 – 400 lei'],
  ['Înlocuire cititor de disc / reparare drive', '150 – 350 lei'],
  ['Reparare sursă de alimentare', '100 – 300 lei'],
  ['Reparare drift controller DualSense', '150 lei'],
  ['Reparare butoane sau trigger DualSense', '30 – 80 lei'],
  ['Joystick-uri magnetice TMR la DualSense (ambele stick-uri, factură, garanție 6 luni)', '150 lei / manetă'],
  ['Curățare după lichid vărsat', 'de la 150 lei'],
  ['Upgrade SSD NVMe (montare + configurare)', 'de la 100 lei + SSD'],
  ['Resoftare PS5 / Xbox Series', 'de la 150 lei'],
];

const faq = [
 { q: 'Cât costă reparația portului HDMI la PS5?', a: 'Înlocuirea portului HDMI la PlayStation 5 costă între 350 și 400 lei, în funcție de gradul de deteriorare a plăcii. Portul este lipit direct pe placa principală și necesită microsoldare la microscop — o intervenție pe care o facem frecvent, cu garanție scrisă. Prețul include și curățarea completă a consolei.' },
 { q: 'Ce este lichidul metalic din PS5 și de ce contează?', a: 'PlayStation 5 nu folosește pastă termică obișnuită între procesor și radiator, ci un aliaj metalic lichid, mult mai conductiv termic. În timp acesta se poate deplasa sau se poate „usca" pe margini, iar consola începe să se supraîncălzească. Reaplicarea lui cere experiență: lichidul metalic este electric conductiv și, dacă ajunge pe componentele din jur, distruge placa. Noi izolăm zona înainte de aplicare și verificăm temperaturile după montaj.' },
 { q: 'PS5-ul meu face zgomot puternic. Ce poate fi?', a: 'Cauza cea mai frecventă este praful acumulat pe ventilator și pe radiator. După 1–2 ani de utilizare fluxul de aer se blochează, iar ventilatorul compensează prin turație maximă. O curățare profesională cu verificarea lichidului metalic rezolvă problema complet. Mai rar, zgomotul vine de la lagărul ventilatorului, care se înlocuiește.' },
 { q: 'PS5 nu mai citește discurile. Se repară?', a: 'Da. La modelele cu unitate optică problemele apar la lentila laser (murdară sau slăbită), la motorul de antrenare sau la cureaua de încărcare a discului. Curățăm și recalibrăm lentila, iar dacă drive-ul este defect îl înlocuim. Atenție: la PS5 unitatea optică este asociată prin software cu placa consolei, deci nu se poate monta pur și simplu una luată de pe altă consolă — reasocierea o facem noi.' },
 { q: 'Se poate repara drift-ul la DualSense?', a: 'Da. Drift-ul (mișcarea involuntară a stick-ului analogic) se rezolvă prin înlocuirea modulului de joystick. Folosim module de calitate și calibrăm controllerul după înlocuire. Reparația durează de regulă o zi și costă 150 lei.' },
 { q: 'Montați joystick-uri Hall Effect pe DualSense?', a: 'Da. Înlocuim ambele stick-uri ale controllerului DualSense cu module Hall Effect (TMR), care citesc poziția magnetic, fără contact mecanic, și de aceea nu mai fac drift în timp. Upgrade-ul pentru ambele joystick-uri costă 150 lei, cu calibrare inclusă.' },
 { q: 'PS5-ul se oprește singur în timpul jocurilor. Ce fac?', a: 'Oprirea în timpul jocurilor indică de obicei supraîncălzire: lichid metalic deplasat, praf acumulat sau ventilator cu performanță redusă. Mai rar, poate fi o problemă pe placa principală sau pe sursa de alimentare. Consultați și <a href="/ps5-se-opreste-singur/">ghidul nostru detaliat despre PS5 care se oprește singur</a>.' },
 { q: 'Am vărsat lichid pe consolă. Ce fac imediat?', a: 'Nu o porniți și nu o puneți la priză — curentul prin plăcile ude face cel mai mare rău. Scoateți-o din priză și aduceți-o cât mai repede. O demontăm complet, curățăm oxidul de pe plăci în baie cu ultrasunete și o uscăm controlat. Cu cât ajunge mai devreme la noi, cu atât cresc șansele de recuperare.' },
 { q: 'Reparați și PS5 Slim sau PS5 Pro?', a: 'Da, reparăm toate modelele: PS5 original (CFI-10xx, 11xx, 12xx), PS5 Slim (CFI-20xx) și PS5 Pro (CFI-70xx), cu disc sau Digital. Prețurile intervențiilor sunt aceleași; diferă doar demontarea și piesele compatibile. Spuneți-ne modelul de pe etichetă când sunați, ca să știm ce pregătim.' },
 { q: 'Cât durează o reparație de PS5?', a: 'În funcție de disponibilitate, multe reparații le facem chiar în aceeași zi. Intervențiile uzuale (curățare, lichid metalic, DualSense drift) se fac în 24–48 de ore. Reparațiile de port HDMI durează 1–2 zile. Intervențiile pe placa principală pot necesita 3–5 zile lucrătoare, în funcție de complexitate și de piesele necesare.' },
 { q: 'Curățarea se plătește separat de reparație?', a: 'Nu. Orice consolă pe care o reparăm pleacă de la noi curățată complet și cu pasta termică sau lichidul metalic reîmprospătate, fără cost suplimentar. Plătiți doar intervenția pentru care ați adus consola. Curățarea se plătește separat doar dacă o aduceți exclusiv pentru mentenanță, fără altă reparație.' },
];
const faqSchema = { '@type': 'FAQPage', mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const schemaSEO = graf(
  serviciu({ nume: 'Reparații PS5 București', tip: 'Service PlayStation 5', url: '/reparatii-ps5-bucuresti/', desc }),
  breadcrumb([{ name: 'Servicii', url: '/servicii/' }, { name: 'Reparații Console', url: '/reparatii-console-gaming-sector-6/' }, { name: 'Reparații PS5', url: '/reparatii-ps5-bucuresti/' }]),
  faqSchema
);
---
<Base title={title} description={desc} schemaExtra={schemaSEO} image={IMG.ogConsola}>
<div class="hero"><div class="wrap">
  <span class="badge">🎮 SERVICE PS5 · ORIGINAL, SLIM ȘI PRO</span>
  <h1>Reparații PS5 București</h1>
  <p class="lead">Service PS5 în atelier propriu, în Militari — Sector 6. Reparăm orice problemă de PlayStation 5: port HDMI defect, lichid metalic deplasat, cititor de disc, SSD, supraîncălzire, DualSense drift și erori de sistem. Diagnosticare gratuită, garanție scrisă, curățare completă inclusă în orice reparație.</p>
  <div class="pills"><span>🔍 Diagnosticare GRATUITĂ</span><span>🧼 Curățare inclusă în reparație</span><span>🛡️ Garanție 6 luni</span><span>💰 Preț ferm, comunicat înainte</span></div>
  <a class="btn btn-white" href={SITE.telefonHref}>📞 {SITE.telefon}</a>
  <a class="btn btn-wa" href={SITE.whatsapp} rel="noopener">💬 WhatsApp</a>
</div></div>
<Cifre />
<div class="wrap">

<section class="sec">
  <h2>🧼 Curățare gratuită inclusă în orice reparație PS5</h2>
  <p>Orice consolă care intră în atelier pentru o reparație pleacă de la noi <strong>curățată complet, cu lichidul metalic sau pasta termică reîmprospătate și cu pad-urile termice verificate</strong> — fără cost suplimentar. Nu o facturăm separat, pentru că oricum demontăm consola ca să ajungem la placă, iar o consolă care se întoarce curată și răcită corect nu se mai întoarce peste trei luni cu aceeași problemă.</p>
  <p>Plătiți doar intervenția pentru care ați adus consola. Curățarea se plătește separat doar dacă aduceți consola exclusiv pentru <a href="/mentenanta-console-ps4-ps5-xbox/">mentenanță preventivă</a>, fără altă reparație.</p>
</section>
<figure style="margin:6px auto 22px;max-width:420px"><img src="/img/reparatii-ps5-curatare-mufa-hdmi.webp" alt="PS5 desfăcut în atelierul din Militari pentru reparație: curățare și înlocuire mufă HDMI" width="540" height="959" loading="lazy" decoding="async" style="width:100%;height:auto;border-radius:12px;display:block" /><figcaption style="font-size:13.5px;color:var(--mut);margin-top:6px;text-align:center">PS5 pe masa de lucru din atelierul nostru din Militari: curățare și înlocuire mufă HDMI.</figcaption></figure>

<section class="sec">
  <h2>Lucrare reală: mufă HDMI defectă, înlocuită în atelier</h2>
  <p>Un PS5 ajuns la noi fără imagine pe televizor. La desfacere, mufa HDMI era defectă, cu urme de oxid în jurul ei. Am scos mufa veche, am curățat zona și am montat o mufă nouă prin microsoldare, apoi am testat consola pe televizor.</p>
  <div class="grid g2" style="margin-top:12px">
    <figure style="margin:0"><img src="/img/ps5-mufa-hdmi-arsa-inainte.webp" alt="Placă PS5 cu mufa HDMI defectă și urme de oxid, înainte de reparație" width="480" height="511" loading="lazy" decoding="async" style="width:100%;height:auto;border-radius:12px;display:block" /><figcaption style="font-size:13.5px;color:var(--mut);margin-top:6px;text-align:center">Înainte: mufa HDMI defectă, cu oxid în jur.</figcaption></figure>
    <figure style="margin:0"><img src="/img/ps5-mufa-hdmi-noua-dupa.webp" alt="Aceeași placă PS5 cu mufa HDMI nouă, lipită și curățată, după reparație" width="480" height="384" loading="lazy" decoding="async" style="width:100%;height:auto;border-radius:12px;display:block" /><figcaption style="font-size:13.5px;color:var(--mut);margin-top:6px;text-align:center">După: mufă HDMI nouă, zona curățată.</figcaption></figure>
  </div>
  <p style="margin-top:12px">Înlocuirea mufei HDMI la PS5 costă 350–400 lei, cu garanție de 6 luni și curățarea consolei inclusă.</p>
</section>
<section class="sec">
  <h2>Servicii de reparație PS5</h2>
  <div class="grid g3">
    <div class="card"><div class="ico">🔌</div><h3>Reparație port HDMI</h3><p>Portul HDMI defect sau deteriorat — nu mai trimite semnal la TV. Îl înlocuim prin microsoldare profesională pe placa principală, cu port nou și testare completă a semnalului 4K/120Hz.</p></div>
    <div class="card"><div class="ico">🌡️</div><h3>Lichid metalic și supraîncălzire</h3><p>PS5 folosește aliaj metalic lichid, nu pastă obișnuită. Îl reaplicăm cu izolarea zonei din jurul procesorului și verificăm temperaturile după montaj.</p></div>
    <div class="card"><div class="ico">💿</div><h3>Cititor de disc</h3><p>Nu citește discuri, le scoate singur sau face zgomot. Curățăm și recalibrăm lentila laser, înlocuim motorul sau drive-ul complet, cu reasociere software la placă.</p></div>
    <div class="card"><div class="ico">💾</div><h3>SSD și upgrade de spațiu</h3><p>SSD intern defect, erori de citire/scriere, consola nu instalează jocuri. Montăm și configurăm și SSD-uri NVMe suplimentare, cu radiator compatibil.</p></div>
    <div class="card"><div class="ico">🎮</div><h3>DualSense drift</h3><p>Stick-ul analogic se mișcă singur sau nu răspunde corect. Înlocuim modulul de joystick, calibrăm și testăm. Lucrăm și pe <a href="/reparatii-controllere-ps4-ps5-xbox/">controllere PS4 și Xbox</a>.</p></div>
    <div class="card"><div class="ico">💧</div><h3>Curățare după lichid vărsat</h3><p>Consolă udată cu băutură sau apă. Demontare completă, curățarea oxidului de pe plăci și uscare controlată. Contează cât de repede ajunge la noi.</p></div>
    <div class="card"><div class="ico">⚡</div><h3>Sursă de alimentare</h3><p>Consola nu pornește, se stinge brusc sau clipește portocaliu. Reparăm sursa la nivel de componentă, nu doar o înlocuim.</p></div>
    <div class="card"><div class="ico">⚙️</div><h3>Resoftare și erori de sistem</h3><p>Erori CE, NW sau SU, consolă blocată în Safe Mode, actualizări eșuate. Resoftăm PS5 și Xbox Series și verificăm integritatea hardware-ului.</p></div>
    <div class="card"><div class="ico">🌀</div><h3>Ventilator zgomotos</h3><p>Zgomot de turbină chiar și în meniu. Curățare, iar dacă lagărul este uzat, înlocuirea ventilatorului cu unul original ca dimensiune și debit.</p></div>
  </div>
</section>

<section class="sec">
  <h2>💰 Cât costă o reparație de PS5</h2>
  <div class="tbl-wrap"><table class="tb"><thead><tr><th>Intervenție</th><th>Preț orientativ</th></tr></thead><tbody>
    {preturi.map(r => <tr><td>{r[0]}</td><td><strong>{r[1]}</strong></td></tr>)}
  </tbody></table></div>
  <p style="font-size:14.5px">Consola nu dă niciun semn de viață? Vedeți ghidul <a href="/ps5-nu-porneste/">PS5 nu pornește</a>.</p>
  <p style="margin-top:12px;font-size:14.5px;color:var(--mut)">Prețurile includ manopera și curățarea completă a consolei. Valoarea exactă o aflați după diagnosticare, care este gratuită și nu vă obligă la nimic — dacă nu vă convine prețul, luați consola înapoi fără să plătiți nimic. Vedeți și <a href="/preturi/">lista completă de prețuri</a>.</p>
</section>

<section class="sec">
  <h2>Ce model de PS5 aveți? Contează la reparație</h2>
  <p>„PS5" înseamnă de fapt trei console diferite pe dinăuntru. Prețul unei intervenții rămâne cel din tabelul de mai sus, dar demontarea, piesele compatibile și câteva capcane diferă de la un model la altul. De aceea vă cerem modelul la telefon: ne spune ce pregătim înainte să ajungeți.</p>
  <div class="grid g3">
    <div class="card-soft"><strong>PS5 original (2020–2023)</strong><span>Codurile CFI-10xx, CFI-11xx și CFI-12xx, în variantă cu disc sau Digital. Consola mare, cu capacele albe care se scot. Aici vedem cele mai multe porturi HDMI rupte și cele mai multe console înfundate de praf, pentru că sunt și cele mai vechi.</span></div>
    <div class="card-soft"><strong>PS5 Slim (din 2023)</strong><span>Codurile CFI-20xx. Mai mică și mai compactă, deci mai puțin loc pentru aer și o demontare cu alți pași. Cititorul de disc e un modul separat, care se prinde de consolă și se asociază cu ea online la prima montare.</span></div>
    <div class="card-soft"><strong>PS5 Pro (din 2024)</strong><span>Codurile CFI-70xx. Cea mai puternică și cea mai scumpă, vine fără cititor de disc (se poate atașa modulul separat). La o consolă de valoarea asta, o reparație pe componentă e aproape întotdeauna mai rentabilă decât orice alternativă.</span></div>
  </div>
  <h3>Unde găsiți modelul exact</h3>
  <p>Codul începe cu „CFI-" și apare pe eticheta cu cod de bare de pe consolă și pe cutie. Dacă consola încă pornește, îl vedeți și în meniu: <strong>Setări → Sistem → Software de sistem → Informații consolă</strong>, la „Nume model". Trimiteți-ni-l pe WhatsApp odată cu o descriere a defectului și vă spunem de la început dacă reparația e una de câteva ore sau de câteva zile.</p>
  <h3>Lucruri care sunt la fel pe toate modelele</h3>
  <p>Toate trei folosesc lichid metalic între procesor și radiator, toate au portul HDMI lipit direct pe placa principală și toate au cititorul de disc legat software de consola cu care a venit. Asta înseamnă că o reparație de port HDMI se face prin microsoldare indiferent de model, că lichidul metalic se reaplică cu aceeași grijă la izolarea zonei și că un cititor luat de pe altă consolă nu funcționează pur și simplu montat. Pentru toate modelele lucrăm în același atelier din Militari, cu aceeași garanție de 6 luni.</p>
</section>

<section class="sec">
  <h2>Probleme frecvente și cum le rezolvăm</h2>

  <h3>Portul HDMI — cea mai frecventă reparație PS5</h3>
  <p>Portul HDMI al PS5 este vulnerabil la deteriorări mecanice (cablu forțat, consolă mutată cu cablul conectat) și la supratensiuni. Simptomele: ecran negru la TV, semnal intermitent, imagine cu artefacte sau lipsa totală a semnalului video. Înlocuim portul prin microsoldare la microscop, cu port HDMI 2.1 compatibil, și testăm semnalul la rezoluție completă 4K/120Hz. Dacă supratensiunea a afectat și cipul de control al semnalului, vă spunem asta la diagnosticare, înainte să începem.</p>

  <h3>Lichidul metalic — particularitatea PlayStation 5</h3>
  <p>Spre deosebire de PS4 sau de un laptop, PlayStation 5 nu are pastă termică între procesor și radiator, ci un <strong>aliaj metalic lichid</strong>, mult mai bun conductor de căldură. Sony a ales soluția asta pentru că procesorul consolei disipă multă căldură într-un spațiu mic. Problema apare în timp: aliajul se poate deplasa spre marginea cipului, mai ales dacă consola a stat mult timp culcată sau a fost transportată în poziții diferite, iar contactul termic se pierde parțial. Consola începe să urle, apoi să se oprească singură în jocurile solicitante.</p>
  <p>Reaplicarea lichidului metalic nu este o operațiune banală și nu se face ca o pastă termică obișnuită. Aliajul este <strong>electric conductiv</strong>: dacă ajunge pe componentele din jurul procesorului, scurtcircuitează placa definitiv. De aceea izolăm perimetrul cipului înainte de aplicare, dozăm cantitatea corect și verificăm temperaturile sub sarcină după remontare. Este exact genul de intervenție unde experiența contează mai mult decât scula — și motivul pentru care nu recomandăm să o încercați acasă după un tutorial.</p>

  <h3>Cititorul de disc — nu citește, scoate discul sau face zgomot</h3>
  <p>La modelele PS5 cu unitate optică, problemele apar în trei locuri: lentila laser (murdară sau slăbită), motorul de antrenare a discului și mecanismul de încărcare. Curățăm și recalibrăm lentila, înlocuim motorul sau, dacă drive-ul este compromis, îl schimbăm complet.</p>
  <p>Un detaliu important pe care mulți nu îl știu: la PS5, unitatea optică este <strong>asociată prin software cu placa consolei</strong>. Nu se poate lua pur și simplu un drive de pe altă consolă și monta — trebuie reasociat, altfel consola nu îl recunoaște. Facem noi această reasociere, ceea ce înseamnă că o consolă cu drive defect nu este un caz pierdut.</p>

  <h3>Supraîncălzirea și zgomotul</h3>
  <p>PS5-ul se oprește singur, ventilatorul urlă sau consola devine fierbinte la atingere? După 1–2 ani de utilizare, praful acumulat în radiator și contactul termic degradat reduc dramatic eficiența răcirii. Curățarea profesională include demontare completă, curățare cu aer comprimat și alcool izopropilic, verificarea sau reaplicarea lichidului metalic, înlocuirea pad-urilor termice și verificarea ventilatorului. Consultați și <a href="/ps5-se-opreste-singur/">ghidul nostru despre PS5 care se oprește singur</a>.</p>

  <h3>DualSense — drift și alte probleme</h3>
  <p>Drift-ul stick-ului analogic este cea mai frecventă problemă a controllerului DualSense. Se manifestă prin mișcări involuntare ale personajului sau camerei în joc. Cauza: uzura mecanică a potențiometrului din modulul de joystick. Alte probleme frecvente: trigger-uri adaptive care nu mai funcționează, butoane care nu răspund, baterie descărcată rapid, mufă USB-C desprinsă. Le rezolvăm pe toate în <a href="/reparatii-controllere-ps4-ps5-xbox/">atelierul nostru de controllere</a>.</p>

  <h3>Coduri de eroare frecvente</h3>
  <ul class="checks">
    <li><strong>CE-108255-1</strong> — eroare de aplicație/joc. Poate indica SSD cu sectoare defecte sau problemă de memorie.</li>
    <li><strong>CE-100005-6</strong> — eroare la instalarea jocului. SSD plin, defect sau probleme de firmware.</li>
    <li><strong>NW-102308-4</strong> — eroare de rețea. Verificăm modulul WiFi și antena.</li>
    <li><strong>SU-101312-8</strong> — eroare de actualizare sistem. Poate necesita reinstalare completă a firmware-ului.</li>
    <li><strong>CE-112840-6</strong> — problemă la unitatea optică sau la asocierea acesteia cu placa.</li>
  </ul>
</section>

<section class="sec">
  <h2>Upgrade SSD și resoftare</h2>
  <p>Pe lângă reparații, facem și două intervenții pe care le cer tot mai des posesorii de PS5:</p>
  <p><strong>Upgrade SSD NVMe.</strong> PlayStation 5 acceptă un SSD M.2 NVMe suplimentar în slotul dedicat, dar cere un model compatibil ca viteză și un radiator care să încapă în lăcaș. Montăm SSD-ul, îl formatăm din consolă și verificăm temperaturile după instalare. Dacă aveți deja SSD-ul, facem doar montarea și configurarea; dacă nu, vă spunem exact ce model se potrivește înainte să cumpărați.</p>
  <p><strong>Resoftare PS5 / Xbox Series.</strong> Pentru console blocate în Safe Mode, cu firmware corupt sau cu actualizări care eșuează la fiecare încercare. Reinstalăm complet software-ul de sistem și verificăm după aceea că problema era într-adevăr software, nu un SSD sau o placă pe cale să cedeze.</p>
</section>

<section class="sec">
  <h2>Mentenanță PS5: când se face și ce cuprinde</h2>
  <p>Ghidul complet, cu ce puteți curăța singuri și cum verificăm metalul lichid: <a href="/mentenanta-console-ps4-ps5-xbox/">mentenanță PS5</a>.</p>
  <p>Mentenanța PS5 nu e o vânzare suplimentară, e ce ține consola departe de atelier. Aproape toate reparațiile scumpe de PlayStation 5 pe care le facem — placă, sursă, cititor — au în spate aceeași poveste: doi-trei ani de praf și un contact termic degradat, care au ținut procesorul la temperatură maximă lună de lună.</p>
  <p><strong>Când.</strong> La 12–18 luni pentru o consolă folosită normal, în cameră curată, pe un raft deschis. La 8–12 luni dacă stă în mobilă închisă, dacă în casă sunt animale de companie sau dacă se joacă zilnic titluri grele. Semnalele că a trecut deja momentul: ventilatorul urcă în turație în meniu, nu doar în joc; aerul care iese pe lateral e fierbinte, nu cald; consola se oprește singură după o oră.</p>
  <p><strong>Ce cuprinde.</strong> Demontare completă, curățarea radiatorului și a ventilatorului, verificarea lichidului metalic și reaplicarea lui dacă s-a deplasat, schimbarea pad-urilor termice, curățarea sursei și a cititorului, apoi test sub sarcină cu urmărirea temperaturilor înainte și după. Predăm consola cu valorile măsurate, nu cu „acum e curată".</p>
  <p><strong>Cât costă.</strong> 200 lei dacă aduceți consola doar pentru mentenanță. Dacă o aduceți pentru orice altă reparație, mentenanța completă e inclusă gratuit — oricum demontăm consola ca să ajungem la placă. Vedeți și pagina generală de <a href="/mentenanta-console-ps4-ps5-xbox/">mentenanță console PS4, PS5 și Xbox</a>.</p>
</section>

