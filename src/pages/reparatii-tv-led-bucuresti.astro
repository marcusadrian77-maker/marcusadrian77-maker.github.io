---
import Base from '../layouts/Base.astro';
import Cifre from '../components/Cifre.astro';
import TrimitePoze from '../components/TrimitePoze.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import { IMG } from '../data/images';
import { SITE } from '../data/site';
import { breadcrumb, graf, serviciu } from '../data/schema';
const title = 'Reparații TV LED și OLED București | Service Televizoare';
const desc = 'Reparații televizoare LED, OLED, QLED și Mini-LED în București. Toate brandurile, diagnostic GRATUIT la domiciliu, garanție. ☎ 0765.461.357';
const canonical = new URL(Astro.url.pathname, SITE.domeniu).href;
const faq = [
 { q: 'Care este diferența dintre LED, OLED și QLED?', a: 'LED folosește retroiluminare cu diode (edge-lit sau direct-lit), OLED are pixeli care emit propria lumină (contrast infinit, negru perfect), iar QLED (Samsung) este un panou LED îmbunătățit cu un strat de puncte cuantice pentru culori mai vii. Fiecare tehnologie are defecte specifice pe care le cunoaștem și le reparăm.' },
 { q: 'Se poate repară burn-în-ul la un televizor OLED?', a: 'Burn-în-ul minor (retenție de imagine) se poate atenua prin cicluri de refresh integrate în televizor. Burn-în-ul permanent este un defect al panelului OLED și nu poate fi eliminat complet, dar poate fi redus vizibil. La diagnosticare evaluăm gravitatea și vă sfătuim sincer dacă merită intervenția.' },
 { q: 'Cât costă înlocuirea barelor LED?', a: 'Prețul variază în funcție de diagonală și numărul de bare. Pentru televizoare de 32-43 inch, înlocuirea barelor LED costă de regulă între 200 și 400 lei (piese + manoperă). La diagonale mai mari (55-65 inch), costul crește proporțional. Diagnosticarea este gratuită.' },
 { q: 'Televizorul meu LED are zone întunecate pe ecran. Ce poate fi?', a: 'Zonele întunecate indică de obicei una sau mai multe LED-uri arse pe barele de retroiluminare. Când un LED se arde, întreaga zona pe care o acoperă rămâne întunecată. Înlocuim barele defecte și verificăm driverul de backlight pentru a preveni recurență.' },
 { q: 'Merită reparat un televizor LED vechi de 8-10 ani?', a: 'Depinde de defect și de diagonală. Un televizor de 55 inch cu o problema de sursa sau backlight se repară la o fracțiune din prețul unuia nou — și merită absolut. Dacă panoul este deteriorat fizic, de obicei nu merită. Va spunem sincer la diagnosticare ce recomandare avem.' },
];
const faqSchema = { '@type': 'FAQPage', mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const schemaSEO = graf(
  serviciu({ nume: 'Reparații TV LED și OLED București', tip: 'Reparații televizoare LED OLED', url: '/reparatii-tv-led-bucuresti/', desc }),
  breadcrumb([{ name: 'Servicii', url: '/servicii/' }, { name: 'Reparații Televizoare', url: '/reparatii-televizoare/' }, { name: 'Reparații TV LED', url: '/reparatii-tv-led-bucuresti/' }]),
  faqSchema
);
---
<Base title={title} description={desc} schemaExtra={schemaSEO} image={IMG.ogTv}>
<div class="hero"><div class="wrap">
  <span class="badge">📺 SERVICE TV LED · OLED · QLED · MINI-LED</span>
  <h1>Reparații TV LED și OLED București</h1>
  <p class="lead">Reparăm televizoare cu orice tehnologie de afișare: LED edge-lit și direct-lit, OLED, QLED, Mini-LED și NanoCell. Diagnosticare gratuită la domiciliu, reparație la nivel de componentă și garanție scrisă 6-12 luni.</p>
  <div class="pills"><span>🔍 Diagnosticare Gratuită</span><span>🛡️ Garanție 6-12 luni</span><span>🏠 Service la domiciliu</span></div>
  <a class="btn btn-white" href={SITE.telefonHref}>📞 {SITE.telefon}</a>
  <a class="btn btn-wa" href={SITE.whatsapp} rel="noopener">💬 WhatsApp</a>
</div></div>
<Cifre />
<div class="wrap">
<section class="sec">
  <h2>Tehnologii TV pe Care le Reparăm</h2>
  <p>Fiecare tip de televizor are defecte specifice tehnologiei sale. Le cunoaștem pe toate și știm exact unde să căutăm problema:</p>
  <div class="grid g3">
    <div class="card"><div class="ico">💡</div><h3>LED Edge-lit</h3><p>Iluminare pe margini — cel mai răspândit tip. Defecte frecvente: bare LED arse (zone întunecate), difuzor deteriorat (pete de lumină), driver de backlight defect. Reparație rapidă, cost accesibil.</p></div>
    <div class="card"><div class="ico">🔆</div><h3>LED Direct-lit / Full Array</h3><p>LED-uri distribuite pe toată suprafață. Mai multe bare înseamnă mai multe puncte potențiale de defect, dar și o reparație mai precisă — înlocuim doar bara afectată, nu toate.</p></div>
    <div class="card"><div class="ico">🌑</div><h3>OLED</h3><p>Pixeli auto-emițători, negru perfect. Defecte specifice: burn-în (retenție permanentă de imagine), placa T-CON, sursa de alimentare, probleme cu panoul la modelele mai vechi.</p></div>
    <div class="card"><div class="ico">🎨</div><h3>QLED (Quantum Dot)</h3><p>Tehnologie Samsung cu puncte cuantice. Defecte similare LED-ului clasic plus: pierderea calibrării culorilor, probleme specifice One Connect Box la modelele premium.</p></div>
    <div class="card"><div class="ico">⚡</div><h3>Mini-LED</h3><p>Sute de zone locale de iluminare. Defecte: blooming excesiv (defect de driver), zone locale care nu se sting complet, probleme de firmware la controlul zonelor.</p></div>
    <div class="card"><div class="ico">🔵</div><h3>NanoCell / QNED</h3><p>Tehnologii LG cu filtrare avansată a culorilor. Defecte similare LED-ului direct-lit, plus probleme specifice de uniformitate a panoului și driver T-CON.</p></div>
  </div>
</section>
<section class="sec">
  <h2>Defecte Frecvente per Tehnologie</h2>
  <h3>Iluminare LED Arsă (Edge-lit și Direct-lit)</h3>
  <p>Cel mai frecvent defect la televizoarele LED: una sau mai multe diode de pe barele de retroiluminare se ard, creând zone întunecate pe ecran. Televizorul poate părea că nu pornește dacă toate barele sunt afectate. Diagnosticăm cu aparatură de măsură, înlocuim barele defecte și verificăm driverul de backlight. Reparația se face de regulă în 1-2 zile.</p>
  <h3>Burn-în OLED</h3>
  <p>Imaginea „fantomă" rămasă permanent pe ecran — logo-uri de posturi TV, bara de taskuri. La televizoarele OLED LG, Samsung și Sony, evaluăm gradul de burn-în și vă sfătuim onest: retenția minoră se poate atenua, burn-în-ul sever la un model vechi de obicei nu justifică costul intervenției.</p>
  <h3>Condensatori Defecți pe Sursa de Alimentare</h3>
  <p>Comun tuturor tehnologiilor, mai ales la modelele fabricate între 2010-2018. Televizorul nu pornește, LED-ul clipește sau se stinge imediat după pornire. Înlocuim condensatorii umflați — o reparație rapidă și ieftină care prelungește viață televizorului cu ani.</p>
  <h3>Placa Principală și Memoria eMMC</h3>
  <p>Televizorul se blochează în logo, repornește continuu sau nu încarcă aplicațiile smart. Rescriem memoria eMMC cu programator specializat sau reparăm circuitele de alimentare de pe placa principală.</p>
</section>
<section class="sec">
  <h2>Toate Brandurile, un Singur Service</h2>
  <p>Lucrăm pe televizoare de la toate producătorii majori. Consultați paginile dedicate pentru detalii specifice fiecărui brand:</p>
  <ul class="checks">
    <li><a href="/reparatii-tv-samsung/">Reparații TV Samsung</a> — QLED, Neo QLED, Crystal UHD, The Frame</li>
    <li><a href="/reparatii-tv-lg/">Reparații TV LG</a> — OLED, NanoCell, QNED, UHD</li>
    <li><a href="/reparatii-tv-sony/">Reparații TV Sony</a> — BRAVIA XR, OLED, LED</li>
    <li><a href="/reparatii-tv-philips/">Reparații TV Philips</a> — Ambilight, LED, OLED</li>
    <li><a href="/reparatii-tv-panasonic/">Reparații TV Panasonic</a> — OLED, LED, Smart TV</li>
    <li><a href="/reparatii-tv-toshiba/">Reparații TV Toshiba</a> — LED, Android TV</li>
    <li><a href="/reparatii-tv-sharp/">Reparații TV Sharp</a> — LED, Aquos, Smart TV</li>
    <li><a href="/reparatii-tv-hisense/">Reparații TV Hisense</a> — VIDAA, ULED, Mini-LED</li>
  </ul>
  <p style="font-size:14.5px;color:var(--mut)">Reparăm și televizoare Horizon, Allview, TCL, Vestel, Grundig sau alte mărci — sunați-ne cu modelul și vă spunem imediat dacă îl putem repară.</p>
  <p>Serviciul nostru acoperă <a href="/reparatii-tv-sectoare/">toate sectoarele din București</a> cu deplasare gratuită. Prețurile orientative le găsiți pe <a href="/preturi/">pagina de prețuri</a>.</p>
</section>
<section class="sec">
  <h2>Întrebări Frecvente</h2>
  <Faq items={faq} />
</section>
<TrimitePoze />

<Cta titlu="📺 Televizorul LED nu mai funcționează corect? Sunați-ne!" text="Diagnosticare gratuită la domiciliu în București. Spuneți-ne marca, diagonală și simptomele — vă orientăm imediat." />
<p style="font-size:14px;color:var(--mut)">Alte servicii: <a href="/reparatii-televizoare/">reparații televizoare</a>, <a href="/reparatii-laptopuri-bucuresti/">reparații laptopuri</a>, <a href="/reparatii-monitoare-lcd/">reparații monitoare</a>, <a href="/reparatii-mentenanță-console-ps4-ps5-xbox-manete/">reparații console</a>.</p>
</div>
</Base>
