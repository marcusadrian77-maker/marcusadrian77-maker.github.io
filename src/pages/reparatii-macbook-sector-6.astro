---
import Base from '../layouts/Base.astro';
import { IMG } from '../data/images';
import Cta from '../components/Cta.astro';
import ContactCard from '../components/ContactCard.astro';
import Faq from '../components/Faq.astro';
import { SITE } from '../data/site';
const faq = [
 { q: 'Reparați MacBook cu chip M1, M2 sau M3?', a: 'Da, reparăm toate generațiile Apple Silicon, inclusiv MacBook Air M1/M2/M3 și MacBook Pro cu chip M1 Pro, M1 Max, M2 Pro, M2 Max, M3 Pro și M3 Max. Avem echipamente specializate pentru lucrul pe aceste plăci de bază.' },
 { q: 'Se pierd datele în urma reparației?', a: 'Reparațiile hardware nu afectează datele stocate. Totuși, îți recomandăm să faci un backup înainte de a aduce echipamentul, mai ales dacă MacBook-ul funcționează parțial. Dacă există risc de pierdere a datelor, te vom anunța în prealabil.' },
 { q: 'Cât durează reparația unui MacBook?', a: 'Reparațiile simple (baterie, tastatură) se finalizează de obicei în 1–2 zile. Reparațiile complexe la nivel de placă de bază pot dura 3–7 zile lucrătoare, în funcție de disponibilitatea pieselor.' },
];
const schemaFaq = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const preturi = [['Diagnosticare','GRATUITĂ'],['Curățare + pastă termică','100 – 200 lei'],['Înlocuire baterie MacBook Air/Pro','200 – 500 lei'],['Reparare port USB-C / MagSafe','150 – 350 lei'],['Înlocuire tastatură Butterfly / Magic','300 – 700 lei'],['Reparații placă logică (microsoldering)','300 – 800 lei'],['Înlocuire display Retina','500 – 1.500 lei']];
import { breadcrumb, graf, serviciu } from '../data/schema';
const desc = "Cauți un service MacBook Sector 6 cu tehnicieni specializați în Apple? Reparăm MacBook Air, MacBook Pro și iMac la nivel de componentă. Diagnostic gratuit.";
const schemaSEO = graf(serviciu({ nume: 'Reparații MacBook Sector 6', tip: 'Reparații MacBook și iMac', url: '/reparatii-macbook-sector-6/', desc , sector: 6 }), breadcrumb([{ name: 'Servicii', url: '/servicii/' }, { name: 'Reparații MacBook', url: '/reparatii-macbook/' }, { name: 'Sector 6', url: '/reparatii-macbook-sector-6/' }]), { '@type': 'FAQPage', mainEntity: schemaFaq.mainEntity });
---
<Base title="Service MacBook Sector 6 | Reparații Apple București" description="Cauți un service MacBook Sector 6 cu tehnicieni specializați în Apple? Reparăm MacBook Air, MacBook Pro și iMac la nivel de componentă. Diagnostic gratuit." schemaExtra={schemaSEO} image={IMG.ogMacbook}>
<div class="hero"><div class="wrap">
  <h1>Service MacBook Sector 6 București</h1>
  <p class="lead">Cauți un service MacBook Sector 6 cu tehnicieni specializați în Apple? La Marcus Electronics din Militari, reparăm MacBook Air, MacBook Pro și iMac la nivel de componentă — cel mai mic cost posibil, garanție 6–12 luni, diagnostic gratuit.</p>
  <a class="btn btn-white" href={SITE.telefonHref}>📞 {SITE.telefon}</a>
  <a class="btn btn-wa" href={SITE.whatsapp} rel="noopener">💬 WhatsApp</a>
</div></div>
<div class="wrap">
<section class="sec">
  <h2>🍎 Modele Apple pe care le Reparăm</h2>
  <div class="grid g4">
    <div class="card-soft"><strong>MacBook Air</strong><span>M1, M2, M3, Intel (toate generațiile)</span></div>
    <div class="card-soft"><strong>MacBook Pro</strong><span>13″, 14″, 16″, Intel și Apple Silicon</span></div>
    <div class="card-soft"><strong>iMac</strong><span>21.5″ și 27″, toate generațiile</span></div>
    <div class="card-soft"><strong>Mac Mini</strong><span>Intel și M1/M2</span></div>
  </div>
  <p style="margin-top:12px">Reparăm și alte mărci de laptopuri — consultați pagina generală de <a href="/reparatii-laptopuri-bucuresti/">reparații laptopuri București</a> pentru lista completă.</p>
</section>
<section class="sec">
  <h2>🔧 Tipuri de Reparații MacBook Efectuate</h2>
  <div class="grid g3">
    <div class="card-soft"><strong>Reparații placă de bază</strong><span>La nivel de chip, condensatori, circuit de alimentare</span></div>
    <div class="card-soft"><strong>Înlocuire baterie</strong><span>Baterii originale sau certificate, calibrare inclusă</span></div>
    <div class="card-soft"><strong>Înlocuire display</strong><span>Panouri Retina, reparare backlight, dungi ecran</span></div>
    <div class="card-soft"><strong>Tastatură defectă</strong><span>Butterfly sau Magic Keyboard, taste lipite/blocate</span></div>
    <div class="card-soft"><strong>MacBook ud / apă vărsată</strong><span>Curățare urgentă ultrasonică</span></div>
    <div class="card-soft"><strong>MacBook nu pornește</strong><span>Diagnosticare circuit alimentare, SMC, T2 chip</span></div>
    <div class="card-soft"><strong>Upgrade SSD</strong><span>Mărire spațiu stocare pe modele compatibile</span></div>
    <div class="card-soft"><strong>Port MagSafe / USB-C defect</strong><span>Reparare sau înlocuire conector</span></div>
    <div class="card-soft"><strong>Ventilator / supraîncălzire</strong><span>Înlocuire fan, pastă termică</span></div>
    <div class="card-soft"><strong>Touch Bar defect</strong><span>Reparare sau înlocuire Touch Bar MacBook Pro</span></div>
  </div>
  <p style="margin-top:12px">Dacă MacBook-ul tău pornește dar ecranul rămâne negru, consultă ghidul nostru dedicat: <a href="/macbook-ecran-negru/">MacBook ecran negru — cauze și soluții</a>.</p>
</section>
<section class="sec">
  <h2>💰 Prețuri Orientative Reparații MacBook</h2>
  {preturi.map(p => <div class="price-row"><span>{p[0]}</span><b>{p[1]}</b></div>)}
  <p style="margin-top:12px;font-size:14px;color:var(--mut)">Intervalele includ piesa și manopera. Prețul ferm se comunică după diagnosticare, care e gratuită și nu vă obligă la nimic. Vezi și <a href="/preturi/">grila completă de prețuri</a>.</p>
</section>

<section class="sec">
  <h2>📍 Unde ne găsiți în Sectorul 6</h2>
  <p>Atelierul este în <strong>Str. Moinești 7, bl. 134 A, Militari</strong>, la câteva minute de Piața Gorjului și de bulevardul Iuliu Maniu. Program: {SITE.program}.</p>
  <p>Primim MacBook-uri de la clienți din <strong>Militari, Drumul Taberei, Crângași, Giulești, Ghencea, Lujerului, Politehnica, Grozăvești, Regie și Gorjului</strong> — din tot Sectorul 6 ajungeți la noi în 10–20 de minute cu mașina, iar de la metrou Păcii sau Gorjului se ajunge pe jos. Lucrăm și pentru clienți din celelalte sectoare și din Ilfov; pentru ei, detaliile complete sunt pe pagina de <a href="/reparatii-macbook/">reparații MacBook București</a>.</p>
  <p>Sectorul 6 concentrează multe firme mici, agenții și freelanceri care lucrează pe Mac, așa că majoritatea reparațiilor de aici sunt urgente: cineva nu-și poate face treaba până nu merge laptopul. De aceea încercăm să dăm un răspuns la diagnostic în aceeași zi în care aduceți aparatul.</p>
</section>

<section class="sec">
  <h2>⏱️ Cât durează și cum decurge</h2>
  <p>Intervențiile uzuale — baterie, port de încărcare, tastatură, curățare și pastă termică — se fac în <strong>24–48 de ore</strong>. Reparațiile pe placa logică, care presupun microscop, schemă electronică și uneori comandă de componente, durează între 2 și 5 zile lucrătoare.</p>
  <p>Procesul e simplu: ne scrieți pe WhatsApp modelul (îl găsiți în „Despre acest Mac" sau pe carcasa din spate) și ce face aparatul, aduceți MacBook-ul la atelier, îl diagnosticăm gratuit și vă comunicăm prețul ferm. Reparăm doar după acordul dumneavoastră. Dacă nu vă convine prețul, luați laptopul înapoi fără să plătiți nimic — diagnosticarea rămâne gratuită indiferent de decizie.</p>
</section>

<section class="sec">
  <h2>💧 Ați vărsat lichid? Ce faceți în primele minute</h2>
  <p>Este cea mai frecventă urgență cu care ajung MacBook-urile la noi și singura în care ce faceți în prima oră schimbă complet rezultatul.</p>
  <ul class="checks">
    <li><strong>Opriți-l imediat</strong>, ținând apăsat butonul de pornire. Nu așteptați să se închidă singur.</li>
    <li><strong>Nu-l puneți la încărcat</strong> și nu-l porniți „să vedeți dacă merge" — coroziunea avansează cu fiecare minut în care placa e sub tensiune.</li>
    <li><strong>Întoarceți-l cu tastatura în jos</strong>, în formă de acoperiș, ca lichidul să nu curgă mai adânc.</li>
    <li><strong>Nu folosiți orez și nu-l uscați cu feonul.</strong> Nu ajută la coroziune, iar căldura poate deforma componentele.</li>
    <li><strong>Aduceți-l cât mai repede.</strong> Un MacBook adus în aceeași zi se recuperează de cele mai multe ori complet; unul adus după două săptămâni are deja piste corodate.</li>
  </ul>
</section>
<section class="sec">
  <h2>⭐ De Ce Marcus Electronics pentru Service MacBook?</h2>
  <ul class="checks">
    <li><strong>Reparare la nivel de chip</strong> — nu înlocuim placa de bază întreagă</li>
    <li><strong>Diagnostic gratuit</strong> — evaluare completă fără costuri</li>
    <li><strong>Garanție 6–12 luni</strong> la toate reparațiile</li>
    <li><strong>Piese certificate prin parteneriat ASWO</strong> — cel mai mare importator european de componente</li>
    <li><strong>Tehnicieni specializați Apple</strong> cu experiență pe toate generațiile</li>
    <li><strong>Membri EURAS</strong> — acces la scheme electronice și suport tehnic internațional</li>
  </ul>
  <p style="margin-top:12px">Pentru a menține MacBook-ul în stare optimă, recomandăm <a href="/curatare-laptop-praf/">curățarea periodică de praf</a> și consultarea <a href="/mentenanta-periodica/">programului de mentenanță periodică</a> — preveniți supraîncălzirea și prelungiți durata de viață a componentelor.</p>
</section>
<ContactCard titlu="📞 Program și Contact Service MacBook" />
<section class="sec">
  <h2>❓ Întrebări Frecvente</h2>
  <Faq items={faq} />
</section>
<p style="font-size:14px;color:var(--mut)">Atelierul este în Str. Moinești 7, Militari, lângă Piața Gorjului și metroul Gorjului — vedeți <a href="/cum-ajungeti-la-atelier/">cum ajungeți la atelier</a>, cu ce aduceți cu dumneavoastră.</p>
<Cta titlu="🍎 MacBook Defect? Sunați-ne!" />
</div>
</Base>
