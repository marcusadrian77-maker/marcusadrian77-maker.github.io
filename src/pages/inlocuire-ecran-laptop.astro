---
import Base from '../layouts/Base.astro';
import Cifre from '../components/Cifre.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import { IMG } from '../data/images';
import { SITE } from '../data/site';
import { breadcrumb, graf, serviciu } from '../data/schema';
const title = 'Înlocuire Ecran Laptop București | Service Display LCD/OLED';
const desc = 'Înlocuire ecran laptop spart sau defect în București: LCD, IPS, OLED, toate brandurile. Diagnostic GRATUIT, garanție 6-12 luni. ☎ 0765.461.357';
const canonical = new URL(Astro.url.pathname, SITE.domeniu).href;
const faq = [
 { q: 'Cât costă înlocuirea ecranului la un laptop?', a: 'Prețul depinde de tipul panelului (TN, IPS, OLED), diagonală, rezoluția și modelul laptopului. Ecranele TN/IPS standard (15.6 inch, Full HD) pornesc de la 300-400 lei cu montaj. Ecranele OLED sau de înaltă rezoluție (4K) sunt mai scumpe. La diagnosticare vă comunicăm prețul exact, ferm.' },
 { q: 'Cât durează înlocuirea ecranului?', a: 'Dacă avem ecranul compatibil în stoc, înlocuirea se face în aceeași zi sau în maxim 24 de ore. Dacă ecranul trebuie comandat (modele mai rare sau OLED), poate dura 3-7 zile lucrătoare. Va comunicăm termenul exact la diagnosticare.' },
 { q: 'Cum știu dacă ecranul trebuie înlocuit sau se poate repară?', a: 'Un ecran spart (crăpături vizibile, pete negre, linii de impact) trebuie înlocuit — nu se repară. Un ecran cu flickering, dungi subțiri sau culori alterate poate avea o problema de cablu flex sau de placa video, nu de panou — și această se poate repară fără înlocuire. La diagnosticare identificăm cauza exactă.' },
 { q: 'Pot pune un ecran mai bun decât originalul?', a: 'În multe cazuri, da. Dacă laptopul a venit cu un panou TN (unghiuri de vizualizare slabe, culori spălăcite), de multe ori putem monta un panou IPS compatibil — cu culori mai bune și unghiuri largi de vizualizare — la un preț similar sau puțin mai mare.' },
 { q: 'Ecranul laptopului palpâie (flickering). Trebuie înlocuit?', a: 'Nu neaparat. Flickering-ul poate fi cauzat de un cablu flex deteriorat, de un invertor defect (la modelele mai vechi cu CCFL) sau de o problema software (driver de placa video). Diagnosticăm cauza exactă înainte de a recomandă înlocuirea.' },
];
const faqSchema = { '@type': 'FAQPage', mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const schemaSEO = graf(
  serviciu({ nume: 'Înlocuire Ecran Laptop București', tip: 'Înlocuire ecran laptop', url: '/inlocuire-ecran-laptop/', desc }),
  breadcrumb([{ name: 'Servicii', url: '/servicii/' }, { name: 'Reparații Laptopuri', url: '/reparatii-laptopuri-bucuresti/' }, { name: 'Înlocuire Ecran Laptop', url: '/inlocuire-ecran-laptop/' }]),
  faqSchema
);
---
<Base title={title} description={desc} schemaExtra={schemaSEO} image={IMG.ogLaptop}>
<div class="hero"><div class="wrap">
  <span class="badge">🖥️ Înlocuire ECRAN LAPTOP</span>
  <h1>Înlocuire Ecran Laptop București</h1>
  <p class="lead">Ecran de laptop spart, cu linii, pete negre sau care palpâie? Înlocuim display-uri LCD, IPS și OLED pentru toate brandurile și diagonalele, cu piese compatibile testate și garanție scrisă.</p>
  <div class="pills"><span>🔍 Diagnosticare Gratuită</span><span>🛡️ Garanție 6-12 luni</span><span>💰 Preț ferm, comunicat înainte</span></div>
  <a class="btn btn-white" href={SITE.telefonHref}>📞 {SITE.telefon}</a>
  <a class="btn btn-wa" href={SITE.whatsapp} rel="noopener">💬 WhatsApp</a>
</div></div>
<Cifre />
<div class="wrap">
<section class="sec">
  <h2>Tipuri de Ecrane pe Care le Înlocuim</h2>
  <div class="grid g3">
    <div class="card"><div class="ico">📐</div><h3>Ecrane TN (Twisted Nematic)</h3><p>Cele mai răspândite la laptopurile de buget și mai vechi. Unghiuri de vizualizare limitate, culori mai puțin fidele. Avantaj: preț accesibil la înlocuire. Posibilitate de upgrade la IPS.</p></div>
    <div class="card"><div class="ico">🎨</div><h3>Ecrane IPS (În-Plane Switching)</h3><p>Standard pentru laptopurile mid-range și business: unghiuri largi de vizualizare, culori fidele. Disponibile în Full HD și 2K. Cele mai frecvente înlocuiri pe care le facem.</p></div>
    <div class="card"><div class="ico">🌑</div><h3>Ecrane OLED / AMOLED</h3><p>Contrast infinit, negru perfect, culori vibrante. Prezente pe laptopuri premium (ASUS ZenBook, Lenovo Yoga, HP Spectre, MacBook Pro). Înlocuire cu panou original sau compatibil de aceeași calitate.</p></div>
    <div class="card"><div class="ico">✋</div><h3>Ecrane Touchscreen</h3><p>Laptopuri 2-în-1 și convertibile cu ecran tactil. Înlocuirea include panoul LCD și digitizer-ul tactil — fie separat (dacă este posibil), fie ca modul complet.</p></div>
  </div>
</section>
<section class="sec">
  <h2>Diagonale și Compatibilitate</h2>
  <p>Înlocuim ecrane de la 11.6 inch (netbook-uri, Chromebook-uri) până la 17.3 inch (laptopuri desktop replacement și gaming). Diagonalele cele mai frecvente:</p>
  <ul class="checks">
    <li><strong>13.3 inch / 14 inch</strong> — laptopuri ultrabook și business (Lenovo ThinkPad, Dell Latitude, HP EliteBook, <a href="/reparatii-macbook/">MacBook Air/Pro</a>)</li>
    <li><strong>15.6 inch</strong> — cea mai populară diagonală, prezența pe laptopuri de toate categoriile</li>
    <li><strong>16 inch / 16.1 inch</strong> — format mai nou, frecvent la laptopurile de gaming și la MacBook Pro 16</li>
    <li><strong>17.3 inch</strong> — laptopuri desktop replacement, modele gaming ASUS ROG, MSI, Lenovo Legion</li>
  </ul>
  <p>Fiecare model de laptop are un cod de panou specific (de exemplu N156HCA-EAB sau LP140WF8-SPR1). Identificăm codul exact prin demontarea ecranului și comandăm piesa compatibilă — garantând potrivirea perfectă ca dimensiune, conectori și rezoluție.</p>
</section>
<section class="sec">
  <h2>Când Trebuie Înlocuit Ecranul</h2>
  <ul class="checks">
    <li><strong>Ecran spart sau crăpat</strong> — după impact, cădere sau presiune pe capac. Crăpăturile nu se repară, ecranul trebuie înlocuit.</li>
    <li><strong>Pete negre care se extind</strong> — lichid (cristale lichide) scurs în interiorul panelului după un impact. Înlocuire necesară.</li>
    <li><strong>Linii colorate verticale sau orizontale</strong> — pot fi de la panou (înlocuire) sau de la cablul flex (reparație mai simplă). Diagnosticăm cauza.</li>
    <li><strong>Ecran complet negru dar laptopul funcționează</strong> — poate fi panoul, backlight-ul, cablul flex sau placa video. La <a href="/reparatii-laptopuri-bucuresti/">laptopurile obișnuite</a> și la <a href="/reparatii-macbook/">MacBook</a>, verificăm toate cauzele posibile înainte de a recomandă înlocuirea.</li>
    <li><strong>Culori distorsionate sau ecran îngălbenit</strong> — panou în degradare. Dacă nu este o setare software, înlocuirea este soluția.</li>
  </ul>
</section>
<section class="sec">
  <h2>Cum Decurge Înlocuirea</h2>
  <ol>
    <li><strong>Ne contactați.</strong> Spuneți-ne marca, modelul exact și ce s-a întâmplat cu ecranul.</li>
    <li><strong>Aduceți laptopul la atelier.</strong> Str. Moinesti 7, Militari, <a href="/reparatii-laptop-sector-6/">Sector 6</a>. Program: {SITE.program}.</li>
    <li><strong>Diagnosticare gratuită.</strong> Verificăm dacă problema este panoul, cablul flex sau altă componentă. Va comunicăm prețul ferm.</li>
    <li><strong>Înlocuirea.</strong> Dacă avem ecranul în stoc — în aceeași zi. Dacă trebuie comandat — 3-7 zile lucrătoare.</li>
    <li><strong>Testare și predare cu garanție 6-12 luni.</strong></li>
  </ol>
  <p>Prețurile orientative pentru toate serviciile noastre de laptop le găsiți pe <a href="/preturi/">pagina de prețuri</a>.</p>
</section>
<section class="sec">
  <h2>Întrebări Frecvente</h2>
  <Faq items={faq} />
</section>
<Cta titlu="🖥️ Ecran de Laptop Spart? Aduceți-l pentru Diagnostic Gratuit!" text="Va spunem prețul exact și termenul de înlocuire înainte de orice intervenție. Sunați sau scrieți pe WhatsApp." />
<p style="font-size:14px;color:var(--mut)">Alte servicii: <a href="/reparatii-laptopuri-bucuresti/">reparații laptopuri</a>, <a href="/reparatii-macbook/">reparații MacBook</a>, <a href="/reparatii-laptop-sector-6/">service laptop Sector 6</a>, <a href="/preturi/">prețuri</a>.</p>
</div>
</Base>
