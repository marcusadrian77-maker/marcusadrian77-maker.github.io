---
import Base from '../layouts/Base.astro';
import TrimitePoze from '../components/TrimitePoze.astro';
import Cifre from '../components/Cifre.astro';
import { graf } from '../data/schema';
import Cta from '../components/Cta.astro';
import { SITE } from '../data/site';
import { IMG } from '../data/images';
import Faq from '../components/Faq.astro';
const schemaSEO = graf({
  '@type': 'WebSite',
  name: 'Marcus Electronics',
  alternateName: 'Reparații Electronice București',
  url: 'https://www.reparatiielectronice.ro/',
  inLanguage: 'ro-RO',
  publisher: { '@type': 'ElectronicsStore', name: 'Marcus Electronics', url: 'https://www.reparatiielectronice.ro/' },
});
const faq = [
  { q: 'Cât costă diagnosticul dacă nu fac reparația?', a: 'Nimic. Diagnosticul este gratuit pentru orice aparat adus în atelierul din Militari, Sector 6, iar la televizoare deplasarea și diagnosticarea la domiciliu sunt gratuite în București și Ilfov. Primiți prețul înainte de reparație și decideți dacă mergem mai departe.' },
  { q: 'Reparați televizorul la mine acasă?', a: 'Da. Peste 90% dintre televizoare le reparăm direct la domiciliu, în București și Ilfov, cu piese pe care le avem pe stoc. Reparațiile pe placa de bază și cele pentru care piesa trebuie comandată se fac în atelier: luăm noi televizorul și vi-l aducem înapoi reparat.' },
  { q: 'Ce aparate pot aduce la atelier?', a: 'Laptopuri, MacBook și iMac, console PS5, PS4 și Xbox, controllere, boxe active, amplificatoare, soundbar-uri, monitoare și cuptoare cu microunde. Atelierul este pe Str. Moinești nr. 7, bl. 134A, sc. A, ap. 1, Militari, Sector 6, deschis de luni până vineri, 10:00–19:00.' },
  { q: 'Pot trimite aparatul prin curier din alt oraș?', a: 'Da, pentru laptopuri, MacBook, console, controllere, boxe active, soundbar-uri și amplificatoare, trimise întregi. Televizoarele și monitoarele nu le primim prin curier, pentru că ecranele se sparg ușor la transport.' },
  { q: 'Ce garanție primesc?', a: 'Garanție scrisă de 6–12 luni, în funcție de reparație, cu factură. La console și MacBook garanția este de 6 luni.' },
];
const echip = [
  { img: IMG.tv, ico: '📺', t: 'Reparații Televizoare', href: '/reparatii-televizoare/', d: 'Samsung, LG, Sony, Philips, Panasonic, Hisense, TCL, Sharp. LED, OLED, QLED, Smart TV. Reparații și la domiciliu!' },
  { img: IMG.laptop, ico: '💻', t: 'Reparații Laptopuri', href: '/reparatii-laptopuri-bucuresti/', d: 'Dell, HP, Lenovo, Asus, Acer, MSI, Toshiba, Samsung, Huawei. Gaming, ultrabook, business.' },
  { img: IMG.macbook, ico: '🍎', t: 'Reparații MacBook & iMac', href: '/reparatii-macbook/', d: 'MacBook Air M1/M2/M3, MacBook Pro, iMac, Mac Mini. Reparații la nivel de chip.' },
  { img: IMG.consola, ico: '🎮', t: 'Reparații Console Gaming', href: '/reparatii-console-gaming-sector-6/', d: 'PS4, PS5, Xbox One, Xbox Series X/S, Nintendo Switch. BLOD, HDMI, supraîncălzire.' },
  { img: IMG.consola, ico: '🕹️', t: 'Reparații PS5', href: '/reparatii-ps5-bucuresti/', d: 'Port HDMI, metal lichid, supraîncălzire, cititor de disc, drift la DualSense. Diagnostic gratuit.' },
  { img: IMG.boxe, ico: '🔊', t: 'Reparații Boxe Active', href: '/reparatii-boxe-active/', d: 'Behringer, JBL, Yamaha, Mackie, QSC, RCF. Amplificatoare, sisteme PA.' },
  { img: IMG.monitor, ico: '🖥️', t: 'Reparații Monitoare LCD', href: '/reparatii-monitoare-lcd/', d: 'Samsung, LG, Dell, Asus, AOC, Philips, BenQ. Gaming, profesionale, 4K, curbate.' },
  { img: IMG.cuptor, ico: '🔥', t: 'Reparații Cuptoare Microunde', href: '/reparatii-cuptoare-cu-microunde/', d: 'Electrolux, Samsung, LG, AEG, Whirlpool, Bosch, Daewoo, Panasonic.' },
  { img: IMG.amplificator, ico: '🎵', t: 'Reparații Amplificatoare', href: '/reparatii-boxe-active/', d: 'Denon, Yamaha, Pioneer, Onkyo, Marantz, NAD. Receivere AV, stereo HiFi.' },
  { img: IMG.tehnician, ico: '🌡️', t: 'Mentenanță PS5, PS4, Xbox', href: '/mentenanta-console-ps4-ps5-xbox/', d: 'Curățare, pastă termică și metal lichid pentru console, cu temperaturi măsurate înainte și după.' },
];
---
<Base title="Reparații și Service Televizoare, Electronice București" description="Televizoare reparate la domiciliu, în tot Bucureștiul. Laptopuri, MacBook, console, boxe și monitoare în atelierul din Militari, Sector 6. Diagnostic gratuit." image={IMG.ogDefault} schemaExtra={{ ...schemaSEO, '@graph': [...schemaSEO['@graph'], { '@type': 'FAQPage', mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) }] }}>
<div class="hero" style={'--hero-img:url(' + IMG.hero + ')'}>
  <div class="wrap">
    <span class="badge">REPARAȚII ELECTRONICE BUCUREȘTI</span>
    <h1>Reparații Electronice București — TV, Laptop, MacBook, Console</h1>
    <p class="lead">Atelier de reparații electronice în Militari, Sector 6. 📺 Reparații TV la domiciliu — tehnicianul vine direct la dvs. acasă. 💻 Laptopuri, MacBook, console, amplificatoare, boxe, monitoare și cuptoare — reparate în atelierul nostru specializat.</p>
    <div class="pills"><span>✅ Diagnostic gratuit</span><span>🛡️ Garanție 6–12 luni</span><span>⚡ Reparăm în aceeași zi</span><span>🚚 Deplasare gratuită la TV</span></div>
    <a class="btn btn-white" href={SITE.telefonHref}>📞 {SITE.telefon}</a>
    <a class="btn btn-wa" href={SITE.whatsapp} rel="noopener">💬 WhatsApp</a>
  </div>
</div>
<Cifre />
<div class="wrap">
<TrimitePoze titlu="📱 Înainte de a ne suna — trimiteți-ne două poze pe WhatsApp" />
<section class="sec">
  <div class="split">
    <div>
      <h2 style="margin-top:0">Despre Marcus Electronics</h2>
      <p>Marcus Electronics este un atelier de reparații electronice din Militari, Sector 6, înființat în 2006. Echipa îmbină experiența — Marcus lucrează în electronică de peste 30 de ani — cu energia unui coleg tânăr, la curent cu tehnologiile noi. Lucrăm la nivel de componentă: găsim piesa care a cedat pe placă — condensator, tranzistor, baretă LED, port HDMI, memorie eMMC — și o înlocuim, în loc să schimbăm subansamblul întreg.</p>
      <p>Televizoarele le reparăm la domiciliu, în București și Ilfov. Laptopurile, MacBook-urile, consolele, boxele și monitoarele se repară în atelier, unde avem stații de lipit cu aer cald, programatoare pentru memorii și piese pe stoc de la ASWO, astfel încât multe reparații se termină în aceeași zi.</p>
      <ul style="margin:0 0 16px;padding-left:20px;line-height:1.7">
        <li><strong>SC Marcus Electronics SRL</strong>, înființată în 2006 · CUI 18426506 · J40/3220/2006</li>
        <li>Atelier propriu: {SITE.adresa}</li>
        <li>Telefon: <a href={SITE.telefonHref}>{SITE.telefon}</a> sau <a href={SITE.telefon2Href}>{SITE.telefon2}</a> · {SITE.program}</li>
        <li>În presă: <a href="/presa/">Evenimentul Zilei, 2011</a>, despre atelierul din strada Moinești</li>
      </ul>
      <a class="btn btn-blue" href="/despre-noi/" style="margin-left:0">Despre noi →</a>
    </div>
    <div class="imgwrap"><img src={IMG.tehnician} alt="Tehnician reparații electronice Marcus Electronics" loading="lazy" decoding="async" /></div>
  </div>
</section>
<section class="sec">
  <div class="section-head"><h2>Echipamente pe care le Reparăm</h2><p>De la televizoare la console și sisteme audio profesionale — reparăm la nivel de componentă, cu diagnostic gratuit.</p></div>
  <div class="grid g3" style="margin-top:18px">
    {echip.map(e => (
      <a class="card has-img" href={e.href}>
        <div class="ph" style={'background-image:url(' + e.img + ')'}></div>
        <div class="ico">{e.ico}</div>
        <div class="bd"><h3>{e.t}</h3><p>{e.d}</p></div>
      </a>
    ))}
  </div>
  <p style="margin-top:16px;font-size:15px">Fiecare categorie are pagina ei, cu prețuri, defectele care se repetă și felul în care lucrăm: <a href="/reparatii-televizoare/">reparații televizoare București</a>, <a href="/reparatii-laptopuri-bucuresti/">reparații laptopuri București</a>, <a href="/reparatii-macbook/">service MacBook București</a>, <a href="/reparatii-console-gaming-sector-6/">reparații console PS4, PS5 și Xbox</a>, <a href="/reparatii-boxe-active/">reparații boxe active și amplificatoare</a>, <a href="/reparatii-monitoare-lcd/">reparații monitoare</a>, <a href="/reparatii-cuptoare-cu-microunde/">reparații cuptoare cu microunde</a>.</p>
</section>
<section class="sec">
  <div class="section-head"><h2>Reparații Console PS4, PS5 și Xbox în București</h2><p>Consolele se repară în atelierul din Militari, pe placă, cu diagnostic gratuit și garanție de 6 luni. Le poți aduce sau trimite prin curier, întregi.</p></div>
  <div class="grid g3" style="margin-top:16px">
    <a class="card" href="/reparatii-ps4-bucuresti/">
      <div class="ico">🎮</div>
      <div class="bd"><h3>Reparații PS4</h3><p>PS4, Slim și Pro: port HDMI, ventilator zgomotos, oprire din supraîncălzire, cititor de disc, sursă. Curățare cu pastă nouă 100–200 lei.</p></div>
    </a>
    <a class="card" href="/reparatii-ps5-bucuresti/">
      <div class="ico">🕹️</div>
      <div class="bd"><h3>Reparații PS5</h3><p>Port HDMI, metal lichid, oprire singură, cititor de disc, drift la DualSense. Mentenanța PS5 costă 200 lei.</p></div>
    </a>
    <a class="card" href="/reparatii-xbox-bucuresti/">
      <div class="ico">🟩</div>
      <div class="bd"><h3>Reparații Xbox</h3><p>Xbox One, Series S și Series X: nu pornește, fără imagine, supraîncălzire, port HDMI, cititor de disc.</p></div>
    </a>
  </div>
  <p style="margin-top:16px;font-size:15px">Reparația plăcii de bază pornește de la 200 lei, iar intervențiile se fac în aceeași zi, în funcție de disponibilitate. Pentru manete există pagina de <a href="/reparatii-controllere-ps4-ps5-xbox/">reparații controllere PS4, PS5 și Xbox</a>, iar pentru curățare preventivă cea de <a href="/mentenanta-console-ps4-ps5-xbox/">mentenanță console</a>. Toate consolele, inclusiv Nintendo Switch, sunt adunate pe pagina de <a href="/reparatii-console-gaming-sector-6/">reparații console București</a>.</p>
</section>
<section class="sec">
  <div class="section-head"><h2>Cât costă o reparație — prețuri orientative</h2><p>Prețurile pot varia în funcție de model și diagonală. Prețul exact îl aflați după diagnosticarea gratuită, înainte de reparație.</p></div>
  <div class="tbl-wrap" style="margin-top:14px"><table class="tb"><thead><tr><th>Aparat</th><th>Reparație</th><th>Preț orientativ</th><th>Unde se face</th></tr></thead><tbody>
    <tr><td>Televizor</td><td>Sursă de alimentare (nu pornește)</td><td><strong>230–530 lei</strong></td><td>La domiciliu</td></tr>
    <tr><td>Televizor</td><td>Barete LED (sunet fără imagine)</td><td><strong>250–1.000 lei</strong></td><td>La domiciliu</td></tr>
    <tr><td>Laptop</td><td>Curățare + pastă termică</td><td><strong>100–200 lei</strong></td><td>Atelier</td></tr>
    <tr><td>PS5</td><td>Mentenanță completă (metal lichid)</td><td><strong>200 lei</strong></td><td>Atelier</td></tr>
    <tr><td>PS4 / Xbox</td><td>Curățare + pastă termică</td><td><strong>100–200 lei</strong></td><td>Atelier</td></tr>
    <tr><td>Console</td><td>Reparație placă de bază</td><td><strong>de la 200 lei</strong></td><td>Atelier</td></tr>
    <tr><td>Controller PS5</td><td>Joystick-uri magnetice TMR (ambele)</td><td><strong>150 lei / manetă</strong></td><td>Atelier</td></tr>
  </tbody></table></div>
  <p style="margin-top:12px;font-size:15px">Lista completă este pe pagina de <a href="/preturi/">prețuri</a>.</p>
</section>
<section class="sec">
  <div class="section-head"><h2>Ce Probleme Putem Rezolva?</h2></div>
  <div class="grid g3" style="margin-top:16px">
    <div class="card-soft"><strong>Ecran spart la laptop</strong><span>Display crăpat la laptop sau MacBook? Îl înlocuim.</span></div>
    <div class="card-soft"><strong>Apă vărsată</strong><span>Reparăm sau înlocuim placa de bază udată.</span></div>
    <div class="card-soft"><strong>Boxe defecte</strong><span>Pornește dar nu se aude? Avem soluția.</span></div>
    <div class="card-soft"><strong>Dungi pe ecran</strong><span>Dungi verticale = nevoie de depanare TV.</span></div>
    <div class="card-soft"><strong>Baterie moartă</strong><span>Nu se încarcă sau a murit? O schimbăm.</span></div>
    <div class="card-soft"><strong>Nu pornește</strong><span>Sursă de alimentare, condensatori devalorizați, circuit de tensiune; la Smart TV blocat rescriem memoria eMMC cu programator specializat.</span></div>
  </div>
</section>
<section class="sec">
  <h2>Suntem o Firmă de Încredere</h2>
  <div class="grid g2">
    <div class="trust-badge"><img src={IMG.firma} alt="Firmă de încredere" loading="lazy" decoding="async" /><div><strong style="color:var(--navy)">Certificați de 10 ani</strong><div style="font-size:14px;color:var(--mut)">Firmă de încredere din 2016 până în prezent, atestat de o companie independentă de testare a calității.</div></div></div>
    <div class="trust-badge"><div style="font-size:42px">🛡️</div><div><strong style="color:var(--navy)">Garanție 6–12 luni</strong><div style="font-size:14px;color:var(--mut)">Toate reparațiile beneficiază de garanție scrisă, în funcție de vechimea echipamentului.</div></div></div>
  </div>
</section>
<section class="sec">
  <div class="section-head"><h2>Cum Să Procedați</h2></div>
  <div class="steps" style="margin-top:16px">
    <div class="step"><span class="n">1</span><span><strong>Sunați-ne sau scrieți pe WhatsApp.</strong> Menționați marca echipamentului, cum se comportă și de când. Cel mai bine atașați poze.</span></div>
    <div class="step"><span class="n">2</span><span><strong>Aduceți echipamentul</strong> la sediu — iar dacă e televizor, tehnicianul vine la dvs. acasă.</span></div>
    <div class="step"><span class="n">3</span><span><strong>Stabilim când e gata.</strong> Facem tot ce se poate pentru rezolvări cât mai rapide.</span></div>
  </div>
</section>
<section class="sec">
  <div class="section-head"><h2>Ce Spun Clienții Noștri</h2></div>
  <div class="grid g3" style="margin-top:16px">
    <div class="card"><p style="color:#f5a623;margin:0 0 6px">★★★★★</p><p style="margin:0">„Am reparat un sistem audio Logitech care avea sursa arsă. Totul ok, mulțumit."</p></div>
    <div class="card"><p style="color:#f5a623;margin:0 0 6px">★★★★★</p><p style="margin:0">„În 2 ore mi-au rezolvat problema. Super profi, merită să apelați la ei."</p></div>
    <div class="card"><p style="color:#f5a623;margin:0 0 6px">★★★★★</p><p style="margin:0">„Recomand! Personal amabil și profesionist! Televizorul nu mai pierde posturile."</p></div>
  </div>
</section>
<section class="sec">
  <h2>Întrebări frecvente</h2>
  <Faq items={faq} />
</section>
<Cta titlu="Aparat Defect? Sunați-ne Acum!" text="Diagnostic gratuit — vă răspundem rapid la telefon sau pe WhatsApp." />
</div>
</Base>
