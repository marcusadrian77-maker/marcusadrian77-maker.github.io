---
import Base from '../layouts/Base.astro';
import Cta from '../components/Cta.astro';
import { SITE } from '../data/site';
import { IMG } from '../data/images';
const echip = [
  { img: IMG.tv, ico: '📺', t: 'Televizoare', href: '/reparatii-televizoare/', d: 'Samsung, LG, Sony, Philips, Panasonic, Hisense, TCL, Sharp. LED, OLED, QLED, Smart TV. Reparații și la domiciliu!' },
  { img: IMG.laptop, ico: '💻', t: 'Laptopuri', href: '/reparatii-laptopuri-bucuresti/', d: 'Dell, HP, Lenovo, Asus, Acer, MSI, Toshiba, Samsung, Huawei. Gaming, ultrabook, business.' },
  { img: IMG.macbook, ico: '🍎', t: 'MacBook & iMac', href: '/reparatii-macbook/', d: 'MacBook Air M1/M2/M3, MacBook Pro, iMac, Mac Mini. Reparații la nivel de chip.' },
  { img: IMG.consola, ico: '🎮', t: 'Console Gaming', href: '/reparatii-mentenanta-console-ps4-ps5-xbox-manete/', d: 'PS4, PS5, Xbox One, Xbox Series X/S, Nintendo Switch. BLOD, HDMI, supraîncălzire.' },
  { img: IMG.boxe, ico: '🔊', t: 'Boxe Active', href: '/reparatii-boxe-active/', d: 'Behringer, JBL, Yamaha, Mackie, QSC, RCF. Amplificatoare, sisteme PA.' },
  { img: IMG.monitor, ico: '🖥️', t: 'Monitoare LCD', href: '/reparatii-monitoare-lcd/', d: 'Samsung, LG, Dell, Asus, AOC, Philips, BenQ. Gaming, profesionale, 4K, curbate.' },
  { img: IMG.cuptor, ico: '🔥', t: 'Cuptoare Microunde', href: '/reparatii-cuptoare-cu-microunde/', d: 'Electrolux, Samsung, LG, AEG, Whirlpool, Bosch, Daewoo, Panasonic.' },
  { img: IMG.amplificator, ico: '🎵', t: 'Amplificatoare', href: '/reparatii-boxe-active/', d: 'Denon, Yamaha, Pioneer, Onkyo, Marantz, NAD. Receivere AV, stereo HiFi.' },
  { img: IMG.tehnician, ico: '🌡️', t: 'Mentenanță Pastă Termică', href: '/mentenanta-profesionala-pasta-termica/', d: 'Înlocuire pastă termică și metal lichid pentru PS4, PS5, Xbox, laptopuri și MacBook.' },
];
---
<Base title="Reparatii Electronice Sector 6 Bucuresti Reparatii TV Laptop" description="Atelier de reparații electronice în sectorul 6 pentru televizoare, monitoare, laptopuri, Macbook Air, Macbook Pro, IMac, boxe active, amplificatoare">
<div class="hero" style={'--hero-img:url(' + IMG.hero + ')'}>
  <div class="wrap">
    <span class="badge">REPARAȚII ELECTRONICE BUCUREȘTI</span>
    <h1>Reparații Electronice Sector 6 — TV, Laptop, MacBook, Console</h1>
    <p class="lead">Atelier de reparații electronice în Militari, Sector 6. 📺 Reparații TV la domiciliu — tehnicianul vine direct la dvs. acasă. 💻 Laptopuri, MacBook, console, amplificatoare, boxe, monitoare și cuptoare — reparate în atelierul nostru specializat.</p>
    <div class="pills"><span>✅ Diagnostic gratuit</span><span>🛡️ Garanție 6–12 luni</span><span>⚡ Reparăm în aceeași zi</span><span>🚚 Deplasare gratuită la TV</span></div>
    <a class="btn btn-white" href={SITE.telefonHref}>📞 {SITE.telefon}</a>
    <a class="btn btn-wa" href={SITE.whatsapp} rel="noopener">💬 WhatsApp</a>
    <p style="margin:16px auto 0;font-size:13.5px;opacity:.9;max-width:640px">📱 Trimiteți pe WhatsApp modelul televizorului de pe eticheta din spatele aparatului. Vă mulțumim!</p>
  </div>
</div>
<div class="wrap">
<section class="sec">
  <div class="grid g6" style="margin-top:26px">
    <div class="stat"><b>25+</b><i>Ani experiență</i></div>
    <div class="stat"><b>10.000+</b><i>Echipamente reparate</i></div>
    <div class="stat"><b>4.9/5</b><i>Rating mediu</i></div>
    <div class="stat"><b>85%</b><i>În aceeași zi</i></div>
    <div class="stat"><b>8+</b><i>Tipuri electronice</i></div>
    <div class="stat"><b>6–12</b><i>Luni garanție</i></div>
  </div>
</section>
<section class="sec">
  <div class="split">
    <div>
      <h2 style="margin-top:0">Despre Marcus Electronics</h2>
      <p>Suntem o echipă tânără și dinamică, capabilă să facă față noilor provocări din domeniul reparațiilor electronice. Punem preț pe calitatea și promptitudinea serviciilor și tratăm fiecare client cu maximă seriozitate.</p>
      <p>Dispunem de un laborator propriu în București, dotat cu echipamente de ultimă generație pentru a diagnostica și rezolva orice defecțiune. <strong>{SITE.firma}</strong> înseamnă profesionalism, seriozitate, încredere și competență.</p>
      <a class="btn btn-blue" href="/despre-noi/" style="margin-left:0">Despre noi →</a>
    </div>
    <div class="imgwrap"><img src={IMG.tehnician} alt="Tehnician reparații electronice Marcus Electronics" loading="lazy" /></div>
  </div>
</section>
<section class="sec">
  <div class="section-head"><h2>Echipamente pe care le Reparăm</h2><p>De la televizoare la console și sisteme audio profesionale — reparăm la nivel de componentă, cu diagnostic gratuit.</p></div>
  <div class="grid g3" style="margin-top:18px">
    {echip.map(e => (
      <a class="card has-img" href={e.href}>
        <div class="ph" style={'background-image:url(' + e.img + ')'}></div>
        <div class="ico">{e.ico}</div>
        <div class="bd"><h3>{e.t}</h3><p>{e.d}</p></div>
      </a>
    ))}
  </div>
</section>
<section class="sec">
  <div class="section-head"><h2>Ce Probleme Putem Rezolva?</h2></div>
  <div class="grid g3" style="margin-top:16px">
    <div class="card-soft"><strong>Display crăpat</strong><span>Ecran spart sau defect? Îl înlocuim.</span></div>
    <div class="card-soft"><strong>Apă vărsată</strong><span>Reparăm sau înlocuim placa de bază udată.</span></div>
    <div class="card-soft"><strong>Boxe defecte</strong><span>Pornește dar nu se aude? Avem soluția.</span></div>
    <div class="card-soft"><strong>Dungi pe ecran</strong><span>Dungi verticale = nevoie de depanare TV.</span></div>
    <div class="card-soft"><strong>Baterie moartă</strong><span>Nu se încarcă sau a murit? O schimbăm.</span></div>
    <div class="card-soft"><strong>Nu pornește</strong><span>Sursă de alimentare, condensatori devalorizați, circuit de tensiune; la Smart TV blocat rescriem memoria eMMC cu programator specializat.</span></div>
  </div>
</section>
<section class="sec">
  <h2>Suntem o Firmă de Încredere</h2>
  <div class="grid g2">
    <div class="trust-badge"><img src={IMG.firma} alt="Firmă de încredere" loading="lazy" /><div><strong style="color:var(--navy)">Certificați de 10 ani</strong><div style="font-size:14px;color:var(--mut)">Firmă de încredere din 2016 până în prezent, atestat de o companie independentă de testare a calității.</div></div></div>
    <div class="trust-badge"><div style="font-size:42px">🛡️</div><div><strong style="color:var(--navy)">Garanție 6–12 luni</strong><div style="font-size:14px;color:var(--mut)">Toate reparațiile beneficiază de garanție scrisă, în funcție de vechimea echipamentului.</div></div></div>
  </div>
</section>
<section class="sec">
  <div class="section-head"><h2>Cum Să Procedați</h2></div>
  <div class="steps" style="margin-top:16px">
    <div class="step"><span class="n">1</span><span><strong>Sunați-ne sau scrieți pe WhatsApp.</strong> Menționați marca echipamentului, cum se comportă și de când. Cel mai bine atașați poze.</span></div>
    <div class="step"><span class="n">2</span><span><strong>Aduceți echipamentul</strong> la sediu — iar dacă e televizor, tehnicianul vine la dvs. acasă.</span></div>
    <div class="step"><span class="n">3</span><span><strong>Stabilim când e gata.</strong> Facem tot ce se poate pentru rezolvări cât mai rapide.</span></div>
  </div>
</section>
<section class="sec">
  <div class="section-head"><h2>Ce Spun Clienții Noștri</h2></div>
  <div class="grid g3" style="margin-top:16px">
    <div class="card"><p style="color:#f5a623;margin:0 0 6px">★★★★★</p><p style="margin:0">„Am reparat un sistem audio Logitech care avea sursa arsă. Totul ok, mulțumit."</p></div>
    <div class="card"><p style="color:#f5a623;margin:0 0 6px">★★★★★</p><p style="margin:0">„În 2 ore mi-au rezolvat problema. Super profi, merită să apelați la ei."</p></div>
    <div class="card"><p style="color:#f5a623;margin:0 0 6px">★★★★★</p><p style="margin:0">„Recomand! Personal amabil și profesionist! Televizorul nu mai pierde posturile."</p></div>
  </div>
</section>
<Cta titlu="Aparat Defect? Sunați-ne Acum!" text="Diagnostic gratuit — vă răspundem rapid la telefon sau pe WhatsApp." />
</div>
</Base>
