---
import Base from '../layouts/Base.astro';
import { IMG } from '../data/images';
import Cta from '../components/Cta.astro';
import ContactCard from '../components/ContactCard.astro';
import Faq from '../components/Faq.astro';
import { SITE } from '../data/site';
const faq = [
 { q: 'Unde sunteți exact în Sectorul 6?', a: 'În Str. Moinești 7, bl. 134 A, în Militari — la câteva minute de Piața Gorjului și de bulevardul Iuliu Maniu. De la stațiile de metrou Gorjului și Păcii se vine pe jos. Program: Luni–Vineri, 10:00–19:00. Nu e nevoie de programare, dar un telefon înainte ne lasă să verificăm dacă avem piesa pe stoc.' },
 { q: 'Veniți să luați laptopul de acasă, din Sectorul 6?', a: 'La televizoare venim la domiciliu, pentru că un televizor mare e greu de transportat. Laptopul se aduce la atelier: reparația lui cere microscop, stație de lipit și aparatură de măsură, care nu se cară la client. Din oricare zonă a Sectorului 6 ajungeți la noi în 10–20 de minute, iar dacă nu puteți veni deloc, laptopul poate fi trimis prin curier.' },
 { q: 'Cât durează depanarea unui laptop?', a: 'Intervențiile uzuale — curățare cu pastă termică, baterie, tastatură, port de alimentare, upgrade SSD — se fac în 24–48 de ore. Înlocuirea de ecran depinde de disponibilitatea panoului: 24–48 de ore pentru un model comun, 3–5 zile dacă trebuie comandat. Reparațiile pe placa de bază durează 3–5 zile lucrătoare.' },
 { q: 'Cât costă să aflu ce are laptopul?', a: 'Nimic. Diagnosticarea este gratuită și rămâne gratuită dacă hotărâți să nu reparați. Vă spunem defectul găsit și prețul ferm înainte de a începe, iar prețul acela nu se mai schimbă pe parcurs. Dacă reparația nu merită față de valoarea laptopului, v-o spunem noi primii.' },
 { q: 'Reparați și laptopuri aduse din alte sectoare?', a: 'Da, primim laptopuri din tot Bucureștiul și din țară, prin curier. Pagina aceasta e despre atelierul din Sectorul 6 pentru că de aici ne vin cei mai mulți clienți; condițiile sunt aceleași pentru toată lumea.' },
];
const schemaFaq = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map(f => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })) };
const preturi = [['Diagnosticare','GRATUITĂ'],['Curățare + pastă termică','80 – 150 lei'],['Înlocuire port de alimentare','80 – 200 lei'],['Înlocuire baterie','100 – 250 lei'],['Înlocuire tastatură','100 – 300 lei'],['Înlocuire ecran / display','200 – 600 lei'],['Reparare placă de bază','200 – 500 lei'],['Upgrade SSD / RAM','50 – 100 lei (manoperă)']];
import { breadcrumb, graf, serviciu } from '../data/schema';
const desc = "Service și depanare laptop în Sectorul 6 — atelier în Militari, lângă Piața Gorjului. Reparație pe componentă, diagnosticare gratuită, garanție 6–12 luni.";
const schemaSEO = graf(serviciu({ nume: 'Service laptop Sector 6', tip: 'Reparații și depanare laptopuri', url: '/reparatii-laptop-sector-6/', desc , sector: 6 }), breadcrumb([{ name: 'Servicii', url: '/servicii/' }, { name: 'Reparații Laptopuri', url: '/reparatii-laptopuri-bucuresti/' }, { name: 'Sector 6', url: '/reparatii-laptop-sector-6/' }]), { '@type': 'FAQPage', mainEntity: schemaFaq.mainEntity });
---
<Base title="Service Laptop Sector 6 | Reparații Laptopuri Militari" description="Service și depanare laptop în Sectorul 6 — atelier în Militari, lângă Piața Gorjului. Reparație pe componentă, diagnosticare gratuită, garanție 6–12 luni." schemaExtra={schemaSEO} image={IMG.ogLaptop}>
<div class="hero"><div class="wrap">
  <h1>Service Laptop Sector 6 București</h1>
  <p class="lead">Căutați un service de laptop în Sectorul 6? Atelierul nostru e în Militari, pe Str. Moinești 7. Facem reparații laptop Sector 6 pentru orice marcă, la nivel de componentă — nu schimbăm placa dacă a cedat o piesă de pe ea. Diagnosticare gratuită și garanție scrisă 6–12 luni.</p>
  <div class="pills"><span>🔍 Diagnosticare GRATUITĂ</span><span>🔬 Reparație pe placă</span><span>🛡️ Garanție 6–12 luni</span><span>🚶 La 2 minute de Piața Gorjului</span></div>
  <a class="btn btn-white" href={SITE.telefonHref}>📞 {SITE.telefon}</a>
  <a class="btn btn-wa" href={SITE.whatsapp} rel="noopener">💬 WhatsApp</a>
</div></div>
<div class="wrap">
<section class="sec">
  <h2>🔧 Reparație și depanare laptop — ce facem</h2>
  <div class="grid g3">
    <div class="card-soft"><strong>Ecran spart / display defect</strong><span>Înlocuire panou LCD/LED, reparare cablu video</span></div>
    <div class="card-soft"><strong>Placă de bază defectă</strong><span>Reparare la nivel de componentă (chip BGA, condensatori)</span></div>
    <div class="card-soft"><strong>Baterie moartă</strong><span>Înlocuire baterie originală sau compatibilă</span></div>
    <div class="card-soft"><strong>Tastatură defectă</strong><span>Înlocuire tastatură, taste lipsă, tastatură udă</span></div>
    <div class="card-soft"><strong>Supraîncălzire</strong><span>Curățare sistem răcire, pastă termică, ventilator</span></div>
    <div class="card-soft"><strong>Nu pornește</strong><span>Diagnosticare sursă alimentare, BIOS, plăci</span></div>
    <div class="card-soft"><strong>Upgrade SSD / RAM</strong><span>Înlocuire HDD cu SSD, mărire memorie RAM</span></div>
    <div class="card-soft"><strong>Instalare Windows / recuperare date</strong><span>Reinstalare sistem, backup date</span></div>
    <div class="card-soft"><strong>Port USB / HDMI / Jack defect</strong><span>Înlocuire sau lipire conector</span></div>
    <div class="card-soft"><strong>Apă vărsată pe laptop</strong><span>Curățare urgentă, reparare componentă afectată</span></div>
  </div>
</section>
<section class="sec">
  <h2>💻 Branduri de Laptop pe care le Reparăm</h2>
  <p>Reparăm laptopuri <strong>Dell, HP, Lenovo, Asus, Acer, MSI, Toshiba, Samsung, Huawei MateBook, LG Gram</strong> și orice alt brand. Lucrăm atât cu laptopuri de birou, cât și cu laptopuri gaming și ultrabook-uri.</p>
  <p>Pentru laptopurile Apple avem pagină separată, cu piese și proceduri proprii: <a href="/reparatii-macbook-sector-6/">service MacBook în Sectorul 6</a>.</p>
</section>
<section class="sec">
  <h2>💰 Prețuri Orientative Reparații Laptop</h2>
  {preturi.map(p => <div class="price-row"><span>{p[0]}</span><b>{p[1]}</b></div>)}
  <p style="margin-top:12px;font-size:14px;color:var(--mut)">Intervalele includ piesa și manopera. Prețul ferm îl aflați după diagnosticare, care e gratuită și nu vă obligă la nimic. Grila completă: <a href="/preturi/">prețuri reparații electronice</a>.</p>
</section>

<section class="sec">
  <h2>📍 Din ce zonă a Sectorului 6 veniți</h2>
  <p>Facem depanare laptop în Sectorul 6 de peste 25 de ani, din același atelier: <strong>Str. Moinești 7, bl. 134 A, Militari</strong>, aproape de Piața Gorjului și de bulevardul Iuliu Maniu. Program: {SITE.program}. Nu e nevoie de programare — puteți veni direct, dar un telefon înainte ne ajută să vă spunem din prima dacă e ceva ce se rezolvă pe loc.</p>
  <ul class="checks">
    <li><strong>Militari și Gorjului.</strong> Suntem în cartier. De la metrou Gorjului sau Păcii se vine pe jos, în câteva minute.</li>
    <li><strong>Drumul Taberei.</strong> Pe Iuliu Maniu sau prin Ghencea, 10–15 minute cu mașina. Cu metroul M5 până la Eroilor și apoi M3 spre Preciziei.</li>
    <li><strong>Crângași și Giulești.</strong> Pe Calea Giulești și Iuliu Maniu, în jur de 15 minute.</li>
    <li><strong>Lujerului și Politehnica.</strong> Două-trei stații de metrou pe M3, direct.</li>
    <li><strong>Grozăvești și Regie.</strong> 15–20 de minute; mulți studenți ne aduc laptopuri în sesiune, pentru curățare sau SSD.</li>
    <li><strong>Ghencea și Plaza.</strong> 10–15 minute pe Iuliu Maniu.</li>
  </ul>
  <p>Vedeți <a href="/cum-ajungeti-la-atelier/">cum ajungeți la atelier</a>, cu ce aduceți cu dumneavoastră și unde parcați. Lucrăm și pentru clienți din celelalte sectoare — detaliile complete sunt pe pagina de <a href="/reparatii-laptopuri-bucuresti/">reparații laptopuri București</a>, iar din afara orașului laptopul se poate trimite <a href="/reparatii-prin-curier/">prin curier</a>.</p>
</section>

<section class="sec">
  <h2>Cele Mai Frecvente Probleme și Ce Înseamnă</h2>

  <h3>Nu pornește deloc</h3>
  <p>Niciun LED, niciun zgomot de ventilator. Cel mai des e circuitul de alimentare de pe placă sau mufa de încărcare, care se slăbește de la introdus și scos cablul de mii de ori. Ambele se repară prin microsoldare, fără schimbarea plăcii. Verificați totuși întâi încărcătorul: dacă are LED și acesta nu se aprinde, problema poate fi chiar în el.</p>

  <h3>Se încinge, face zgomot, se închide singur</h3>
  <p>Cel mai des întâlnit defect și, din fericire, cel mai ieftin. Praful se acumulează în radiator formând un covor compact, pasta termică se usucă, iar procesorul ajunge la temperatura de protecție și taie alimentarea. Curățarea completă cu pastă nouă costă 80–150 de lei și readuce laptopul la temperaturile normale. Detalii în ghidul nostru: <a href="/laptop-se-incalzeste/">laptopul se încălzește excesiv</a>.</p>

  <h3>Ecran spart, cu dungi sau cu pete</h3>
  <p>Ecranul crăpat după o cădere se înlocuiește. Dungile apărute fără lovitură vin de obicei de la cablul video care trece prin balama și se uzează la închiderea capacului — se rezolvă mai ieftin decât un display nou. Vedeți și pagina de <a href="/inlocuire-ecran-laptop/">înlocuire ecran laptop</a>.</p>

  <h3>Baterie umflată sau care nu ține</h3>
  <p>O baterie umflată presează trackpadul de dedesubt și, în cazuri avansate, deformează carcasa. Nu amânați și nu apăsați pe ea. O înlocuim și gestionăm bateria veche pentru reciclare. Detalii: <a href="/inlocuire-baterie-laptop/">înlocuire baterie laptop</a>.</p>

  <h3>Apă sau cafea vărsată</h3>
  <p>Urgență reală. Opriți laptopul imediat ținând apăsat butonul de pornire, nu-l puneți la încărcat și aduceți-l cât mai repede. Coroziunea avansează cu fiecare oră în care placa stă sub tensiune, iar un laptop adus în aceeași zi se recuperează de cele mai multe ori complet.</p>
</section>

<section class="sec">
  <h2>⏱️ Cât Durează</h2>
  <p>Intervențiile uzuale — curățare cu pastă termică, baterie, tastatură, port de alimentare, upgrade SSD — se fac în <strong>24–48 de ore</strong>. Înlocuirea de ecran depinde de disponibilitatea panoului: dacă e un model comun, tot în 24–48 de ore; dacă trebuie comandat, 3–5 zile. Reparațiile pe placa de bază durează 3–5 zile lucrătoare.</p>
  <p>Vă anunțăm telefonic imediat ce laptopul e gata. Dacă în timpul reparației apare ceva neprevăzut, vă sunăm înainte de a continua — prețul comunicat rămâne prețul plătit.</p>
</section>
<section class="sec">
  <h2>⭐ De Ce Să Alegi Marcus Electronics?</h2>
  <ul class="checks">
    <li><strong>Diagnostic gratuit</strong> — plătești doar dacă accepți reparația</li>
    <li><strong>Garanție 6–12 luni</strong> la toate intervențiile</li>
    <li><strong>Reparare la nivel de componentă</strong> — reparăm strict ce este defect</li>
    <li><strong>Piese originale</strong> certificate prin parteneriat ASWO</li>
    <li><strong>Peste 25 ani experiență</strong> în reparații electronice</li>
    <li><strong>Membri EURAS</strong> — acces la resurse tehnice internaționale</li>
  </ul>
</section>
<ContactCard />
<section class="sec">
  <h2>❓ Întrebări Frecvente</h2>
  <Faq items={faq} />
</section>
<Cta titlu="💻 Laptop Defect? Sunați-ne!" />
</div>
</Base>
